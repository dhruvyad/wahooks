diff -ruN a/nodequeue.go q/nodequeue.go
--- a/nodequeue.go	1970-01-01 05:30:00
+++ q/nodequeue.go	2026-11-09 10:53:49
@@ -0,0 +1,77 @@
+// (patched) Ordered handler queue, see client.go.
+
+package whatsmeow
+
+import (
+	"sync"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+)
+
+// nodeQueue is the FIFO between a connection's frame reader and its handler loop. It replaces a 2,048-slot channel
+// that cost 16 KiB per connection up front and, when full, handed each further node to its own goroutine, so a
+// large offline backlog could be handled out of order (prekey before whisper, retry receipts). nodeQueue never
+// blocks the reader and never reorders: it holds nothing while idle, grows during a burst and releases the memory
+// once drained.
+type nodeQueue struct {
+	mu     sync.Mutex
+	items  []*waBinary.Node
+	head   int
+	signal chan struct{} // capacity 1: "something was pushed since you last looked"
+}
+
+// nodeQueueKeep is the backing capacity kept after the queue drains; anything larger is released.
+const nodeQueueKeep = 64
+
+func newNodeQueue() *nodeQueue {
+	return &nodeQueue{signal: make(chan struct{}, 1)}
+}
+
+func (q *nodeQueue) push(node *waBinary.Node) {
+	q.mu.Lock()
+	if q.head > 256 && q.head*2 >= len(q.items) {
+		// Mostly consumed backing array during a long burst: slide the live part down instead of growing.
+		n := copy(q.items, q.items[q.head:])
+		clear(q.items[n:])
+		q.items = q.items[:n]
+		q.head = 0
+	}
+	q.items = append(q.items, node)
+	q.mu.Unlock()
+	select {
+	case q.signal <- struct{}{}:
+	default:
+	}
+}
+
+// pop returns the oldest queued node, or nil if the queue is empty.
+func (q *nodeQueue) pop() *waBinary.Node {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	if q.head >= len(q.items) {
+		q.resetLocked()
+		return nil
+	}
+	node := q.items[q.head]
+	q.items[q.head] = nil
+	q.head++
+	if q.head >= len(q.items) {
+		q.resetLocked()
+	}
+	return node
+}
+
+func (q *nodeQueue) resetLocked() {
+	if cap(q.items) > nodeQueueKeep {
+		q.items = nil
+	} else {
+		q.items = q.items[:0]
+	}
+	q.head = 0
+}
+
+func (q *nodeQueue) len() int {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	return len(q.items) - q.head
+}
diff -ruN a/nodequeue_test.go q/nodequeue_test.go
--- a/nodequeue_test.go	1970-01-01 05:30:00
+++ q/nodequeue_test.go	2026-11-09 10:53:49
@@ -0,0 +1,40 @@
+package whatsmeow
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+)
+
+func TestNodeQueueOrderAndRelease(t *testing.T) {
+	q := newNodeQueue()
+	if q.pop() != nil {
+		t.Fatal("empty queue returned a node")
+	}
+	const n = 5000
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < n; i++ {
+			q.push(&waBinary.Node{Tag: "message", Attrs: waBinary.Attrs{"id": fmt.Sprint(i)}})
+		}
+	}()
+	for i := 0; i < n; {
+		node := q.pop()
+		if node == nil {
+			<-q.signal
+			continue
+		}
+		if node.Attrs["id"] != fmt.Sprint(i) {
+			t.Fatalf("out of order: got %v at %d", node.Attrs["id"], i)
+		}
+		i++
+	}
+	wg.Wait()
+	if q.len() != 0 || cap(q.items) > nodeQueueKeep {
+		t.Fatalf("not released after drain: len %d cap %d", q.len(), cap(q.items))
+	}
+}
